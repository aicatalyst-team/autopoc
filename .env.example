# AutoPoC Configuration
#
# Usage: source this file before running autopoc, or export the variables:
#   source .env && autopoc --name my-project --repo https://github.com/...
#
# Note: this file is sourced by bash, so shell commands like $(cat ...) work.
# Python's dotenv does NOT execute shell commands, but environment variables
# set via `source` take priority over .env file values.

# --- LLM ---
# At least one LLM provider must be configured: ANTHROPIC_API_KEY,
# VERTEX_PROJECT, or LLM_BASE_URL.
#
# Option A: Anthropic direct
ANTHROPIC_API_KEY=sk-ant-...
#
# Option B: Anthropic via Vertex AI
# VERTEX_PROJECT=my-google-cloud-project
# VERTEX_LOCATION=us-east5
#
# Option C: OpenAI-compatible endpoint (vLLM, Ollama, etc.)
# LLM_BASE_URL=http://qwen-coder-svc.vllm:8000/v1
# LLM_MODEL=qwen2.5-coder-32b   # required when using LLM_BASE_URL
# LLM_API_KEY=none

# Optional: Override the default model (for Anthropic providers)
# LLM_MODEL=claude-3-5-haiku@20241022

# Max retries for LLM API calls (default 0 to fail fast on rate limits instead of hanging)
LLM_MAX_RETRIES=0

# --- LLM Fallback (optional) ---
# When BOTH a cloud provider (Anthropic/Vertex) AND LLM_BASE_URL are
# configured, the cloud provider is used as primary and the
# OpenAI-compatible endpoint is the automatic fallback.
# On retryable errors (429/500/502/503/529), the request is transparently
# retried on the fallback endpoint.
#
# When ONLY LLM_BASE_URL is configured (no cloud provider), it is used
# as the sole provider — no fallback behavior.
#
# Set to false to disable fallback (even when both providers are configured):
# LLM_FALLBACK_ENABLED=true

# --- Fork target ---
# Where to fork the source repo: "gitlab" (default) or "github"
# Can be overridden with --target flag on the CLI
FORK_TARGET=gitlab

# --- GitLab (required when FORK_TARGET=gitlab) ---
GITLAB_URL=https://gitlab.internal.example.com
GITLAB_TOKEN=glpat-...
GITLAB_GROUP=poc-demos

# --- GitHub (required when FORK_TARGET=github) ---
# Creates a true GitHub fork (parent-child relationship) via the GitHub API.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_ORG=my-org    # Optional — if unset, forks to the authenticated user's account

# --- Quay Container Registry ---
QUAY_REGISTRY=quay.io
QUAY_ORG=my-org
QUAY_TOKEN=...

# --- OpenShift ---
OPENSHIFT_API_URL=https://api.cluster.example.com:6443
OPENSHIFT_TOKEN=sha256~...
OPENSHIFT_NAMESPACE_PREFIX=poc

# --- Retry limits ---
MAX_BUILD_RETRIES=3
MAX_DEPLOY_RETRIES=2
MAX_CONTAINER_FIX_RETRIES=2

# --- Google Sheet integration (for `autopoc run-sheet`) ---
# Service account credentials for reading/writing the POC Explorer spreadsheet.
# Uses a separate env var (not GOOGLE_APPLICATION_CREDENTIALS) to avoid
# hijacking Vertex AI auth, which should use your user identity via ADC.
# AUTOPOC_SHEET_CREDENTIALS=/path/to/service-account-key.json
# AUTOPOC_SHEET_ID=your-spreadsheet-id-here

# How many sheet tabs (left to right) to scan for candidates (default: 4)
# MAX_EVALUATED_SHEETS=4

# How many PoC pipelines to run in a single session (default: 2)
# MAX_BATCHED_POC=2

# --- OGX LLM Proxy (for PoC projects that need LLM access) ---
# When set, PoC projects that require an LLM API (e.g., OPENAI_API_KEY)
# will be directed to this OGX server instead of needing real API keys.
# OGX_BASE_URL=http://ogx-svc.ogx.svc.cluster.local:8321/v1
# OGX_MODEL=qwen3-32b
# OGX_API_KEY=none

# --- Working directory ---
WORK_DIR=/tmp/autopoc

# --- LangSmith tracing (optional) ---
# Enable tracing to LangSmith for debugging LLM calls and agent behavior.
# Sign up at https://smith.langchain.com/ to get an API key.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=autopoc
#
# For LangGraph Studio: a langgraph.json config file is included in the repo root.
# Open the project directory in LangGraph Studio to visualize and debug runs.
